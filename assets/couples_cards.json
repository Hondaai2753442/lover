[
  {
    "id": "q001",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "لو نقدر نعيد يوم واحد عشناه مع بعض، أي يوم تختار وليه؟",
    "purpose": "افتحوا حوارًا عن ذكرى جميلة."
  },
  {
    "id": "q002",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش شيء بسيط أسويه ويخلّي يومك أحسن؟",
    "purpose": "تعرّفوا على التفاصيل الصغيرة التي تصنع فرقًا."
  },
  {
    "id": "q003",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش تجربة جديدة ودّك نجربها سوا خلال الشهر الجاي؟",
    "purpose": "اختاروا فكرة قابلة للتنفيذ."
  },
  {
    "id": "q004",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "متى تحس إنّي أسمعك وأفهمك فعلًا؟",
    "purpose": "تبادلوا الإجابة بهدوء ومن دون مقاطعة."
  },
  {
    "id": "q005",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "لو علاقتنا كانت رحلة، وش اسم الرحلة؟",
    "purpose": "خلّوا الإجابة مرحة أو عاطفية."
  },
  {
    "id": "q006",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش صفة فيك تتمنى أفهمها أكثر؟",
    "purpose": "اسألوا سؤال متابعة بلطف إذا رغبتوا."
  },
  {
    "id": "r001",
    "category": "الرومانسية",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "اذكر ثلاث صفات تحبها في الطرف الثاني، ومع كل صفة موقف يثبتها.",
    "purpose": "عبّروا عن التقدير بأمثلة حقيقية."
  },
  {
    "id": "r002",
    "category": "الرومانسية",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أكثر تصرّف يخليك تحس إنك مهم عندي؟",
    "purpose": "تحدّثوا عن طرق التعبير عن الاهتمام."
  },
  {
    "id": "r003",
    "category": "الرومانسية",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "اكتبوا لبعض رسالة قصيرة فيها شيء تقدّرونه في بعض، ثم اقرأوها إذا ارتحتوا.",
    "purpose": "المشاركة اختيارية؛ يكفي الاحتفاظ بالرسالة."
  },
  {
    "id": "r004",
    "category": "الرومانسية",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش ذكرى بيننا تبتسم كل ما تذكّرتها؟",
    "purpose": "استرجعوا التفاصيل اللي جعلت الذكرى مميزة."
  },
  {
    "id": "r005",
    "category": "الرومانسية",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "خطّطوا لموعد بسيط بميزانية محدودة، وكل واحد يقترح فكرة.",
    "purpose": "حوّلوا التحدي إلى خطة ممكنة."
  },
  {
    "id": "r006",
    "category": "الرومانسية",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش الطريقة اللي تفضّلها عشان أواسيك في يوم صعب؟",
    "purpose": "لا توجد إجابة صحيحة أو خاطئة."
  },
  {
    "id": "f001",
    "category": "المرح",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "قلّد طريقة الطرف الثاني لما يتحمّس، وخله يخمّن الموقف.",
    "purpose": "خلوها ضحك وبدون تقليد جارح."
  },
  {
    "id": "f002",
    "category": "المرح",
    "type": "سؤال",
    "level": "خفيف",
    "text": "لو كل واحد فينا صار شخصية كرتونية، مين بيكون وليه؟",
    "purpose": "اختاروا إجاباتكم بخيال واسع."
  },
  {
    "id": "f003",
    "category": "المرح",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "سوّوا إعلانًا مدته عشر ثوانٍ عن أكلة تحبونها أنتم الاثنين.",
    "purpose": "الأفضل هو الأكثر إبداعًا، مو الأكثر جدية."
  },
  {
    "id": "f004",
    "category": "المرح",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أغرب عادة لطيفة لاحظتها عليّ؟",
    "purpose": "اختاروا شيئًا يضحككم الاثنين."
  },
  {
    "id": "f005",
    "category": "المرح",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "كل واحد يختار أغنية تعبّر عن مزاجه اليوم ويشرح اختياره.",
    "purpose": "مشاركة الأغنية أو شرحها حسب الرغبة."
  },
  {
    "id": "f006",
    "category": "المرح",
    "type": "سؤال",
    "level": "خفيف",
    "text": "لو عندنا يوم كامل بدون أي التزامات، كيف نقضيه؟",
    "purpose": "قارنوا بين أفكاركم واختاروا جزءًا تنفذونه."
  },
  {
    "id": "التفاهم1",
    "category": "التفاهم",
    "type": "سؤال",
    "level": "متوسط",
    "text": "إذا اختلفنا، وش الشيء اللي يساعدك تكمل الحوار بهدوء؟",
    "purpose": "اتفقوا على إشارة أو استراحة عند الحاجة."
  },
  {
    "id": "t002",
    "category": "التفاهم",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش هدف تتمنى ندعم بعض في تحقيقه خلال السنة القادمة؟",
    "purpose": "حددوا خطوة صغيرة تساعدكم على البدء."
  },
  {
    "id": "t003",
    "category": "التفاهم",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "كل واحد يذكر شيئًا واحدًا يقدر يسويه هذا الأسبوع لتخفيف الضغط عن الثاني.",
    "purpose": "خلو الوعد واقعيًا وواضحًا."
  },
  {
    "id": "t004",
    "category": "التفاهم",
    "type": "سؤال",
    "level": "متوسط",
    "text": "متى تحتاج مساحة لنفسك، وكيف تفضّل توضح هذا الشيء؟",
    "purpose": "احترموا اختلاف الاحتياجات والحدود."
  },
  {
    "id": "t005",
    "category": "التفاهم",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش عادة مشتركة بسيطة ممكن تقوّي تواصلنا؟",
    "purpose": "اختاروا عادة سهلة تقدرون تستمرون عليها."
  },
  {
    "id": "t006",
    "category": "التفاهم",
    "type": "تحدّي",
    "level": "خفيف",
    "text": "تبادلوا الأدوار: كل واحد يلخّص وجهة نظر الثاني في موضوع بسيط، والثاني يوضح إذا فهمه صح.",
    "purpose": "الهدف الفهم، مو الفوز بالنقاش."
  },
  {
    "id": "q025",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أكثر شيء بسيط يخلّيك تبتسم خلال يومك؟",
    "purpose": "ابدؤوا بإجابة قصيرة ثم اسألوا سؤال متابعة."
  },
  {
    "id": "q026",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "لو عندنا ساعتين فاضيتين اليوم، كيف ودك نقضيها؟",
    "purpose": "اختاروا فكرة قابلة للتنفيذ."
  },
  {
    "id": "q027",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أكلة تذكّرك بذكرى حلوة؟",
    "purpose": "شاركوا القصة وراء الذكرى."
  },
  {
    "id": "q028",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أكثر عادة لطيفة تحبها فيني؟",
    "purpose": "اذكروا مثالًا محددًا."
  },
  {
    "id": "q029",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "أي مكان قريب ودك نزوره سوا؟",
    "purpose": "حوّلوا الإجابة إلى خطة إن ناسبتكم."
  },
  {
    "id": "q030",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "خفيف",
    "text": "اذكر شيئًا واحدًا تقدّره في الطرف الثاني اليوم.",
    "purpose": "خلوها كلمة صادقة ومحددة."
  },
  {
    "id": "q031",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "خفيف",
    "text": "متى حسّيت أن الطرف الثاني وقف معك؟",
    "purpose": "اشكروا بعض على الموقف."
  },
  {
    "id": "q032",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "خفيف",
    "text": "وش صفة في شريكك تتمنى ما تتغير أبدًا؟",
    "purpose": "قولوا ليش هالصفة مهمة لكم."
  },
  {
    "id": "q033",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "كل واحد يختار أغنية تذكّره بلحظة حلوة بينكم.",
    "purpose": "شغّلوا مقطعًا قصيرًا إذا رغبتوا."
  },
  {
    "id": "q034",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "سوّوا مشروبًا أو وجبة خفيفة للطرف الثاني.",
    "purpose": "خلّوا المهمة اختيارية وبسيطة."
  },
  {
    "id": "q035",
    "category": "التخمين",
    "type": "تخمين",
    "level": "خفيف",
    "text": "خمنوا: وش الوجبة اللي يختارها الطرف الثاني لو يقدر ياكل شيء واحد اليوم؟",
    "purpose": "كل طرف يكتب تخمينه قبل كشف الإجابة."
  },
  {
    "id": "q036",
    "category": "التخمين",
    "type": "تخمين",
    "level": "متوسط",
    "text": "خمنوا: وش أكثر شيء يخفف توتر الطرف الثاني؟",
    "purpose": "قارنوا التخمين بالإجابة الفعلية."
  },
  {
    "id": "q037",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "جلسة بيت هادئة أم طلعة عفوية؟",
    "purpose": "اختاروا معًا أو اشرحوا اختلافكم."
  },
  {
    "id": "q038",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "قهوة أم شاي؟",
    "purpose": "اسألوا عن السبب بعد الاختيار."
  },
  {
    "id": "q039",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "البحر أم الجبل؟",
    "purpose": "تخيلوا رحلة قصيرة للمكان المختار."
  },
  {
    "id": "q040",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "تخطيط مسبق أم مفاجأة لطيفة؟",
    "purpose": "تعرفوا على تفضيلات بعض."
  },
  {
    "id": "q041",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "متوسط",
    "text": "رسالة مكتوبة أم مكالمة طويلة؟",
    "purpose": "اتفقوا على طريقة تواصل تناسبكم."
  },
  {
    "id": "q042",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش شيء تتمنى أن نفهمه عن بعض بشكل أفضل؟",
    "purpose": "استمعوا دون مقاطعة أو دفاع."
  },
  {
    "id": "q043",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش عادة مشتركة ودك نبدأها هذا الشهر؟",
    "purpose": "اختاروا خطوة صغيرة."
  },
  {
    "id": "q044",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش الشيء اللي يساعدك تحس بالتقدير؟",
    "purpose": "ناقشوا أمثلة عملية."
  },
  {
    "id": "q045",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "كيف تفضّل أن أساندك إذا كان يومك صعبًا؟",
    "purpose": "اتفقوا على إشارة أو طريقة بسيطة."
  },
  {
    "id": "q046",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "متوسط",
    "text": "اذكر موقفًا صغيرًا من الطرف الثاني ما نسيته.",
    "purpose": "شاركوا لماذا بقي في الذاكرة."
  },
  {
    "id": "q047",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "متوسط",
    "text": "وش شيء تعلمته من شريكك؟",
    "purpose": "اذكروا أثره عليك."
  },
  {
    "id": "q048",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "متوسط",
    "text": "خططوا لموعد بسيط بميزانية تتفقون عليها.",
    "purpose": "الهدف وقت ممتع وليس تكلفة عالية."
  },
  {
    "id": "q049",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "متوسط",
    "text": "كل طرف يقترح نشاطًا جديدًا ويختار الآخر واحدًا منهما.",
    "purpose": "خلوا القرار بالتبادل."
  },
  {
    "id": "q050",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "وش أجمل شيء صار بينكم مؤخرًا؟",
    "purpose": "ركزوا على ما تريدون تكراره."
  },
  {
    "id": "q051",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "وش الشيء الذي يجعل وقتكم معًا ذا معنى؟",
    "purpose": "ما فيه إجابة صحيحة أو خاطئة."
  },
  {
    "id": "q052",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "متى يكون الاستماع لك أهم من تقديم الحلول؟",
    "purpose": "وضحوا ما تحتاجونه في المواقف الصعبة."
  },
  {
    "id": "q053",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "وش معنى الدعم بالنسبة لك في هذه المرحلة من حياتك؟",
    "purpose": "تجنبوا افتراض أن احتياجاتكم متطابقة."
  },
  {
    "id": "q054",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "كيف نقدر نختلف باحترام حتى لو ما اتفقنا؟",
    "purpose": "اتفقوا على قاعدة واحدة للنقاش."
  },
  {
    "id": "q055",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "عميق",
    "text": "وش جانب من شخصيتك تتمنى أن أقدّره أكثر؟",
    "purpose": "اسمعوا الإجابة بدون استعجال."
  },
  {
    "id": "q056",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "عميق",
    "text": "وش حلم صغير ممكن نساعد بعض على تحقيقه؟",
    "purpose": "حددوا خطوة أولى واقعية."
  },
  {
    "id": "q057",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "قولوا ثلاث أشياء تحبونها في يومكم العادي معًا.",
    "purpose": "خلوها تفاصيل حقيقية."
  },
  {
    "id": "q058",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "فيلم كوميدي أم مغامرة؟",
    "purpose": "اختاروا ما يناسب مزاجكم."
  },
  {
    "id": "q059",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "رحلة قصيرة أم عطلة طويلة بعد تخطيط؟",
    "purpose": "قارنوا الوقت والميزانية."
  },
  {
    "id": "q060",
    "category": "التخمين",
    "type": "تخمين",
    "level": "متوسط",
    "text": "خمنوا: ما الهدية البسيطة التي تسعد الطرف الثاني؟",
    "purpose": "الفكرة في معرفة التفضيل لا في الشراء."
  },
  {
    "id": "q061",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش ذكرى من طفولتك تحب تحكيها؟",
    "purpose": "اتركوا مساحة للتفاصيل."
  },
  {
    "id": "q062",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش شيء ودك نجربه لأول مرة سوا؟",
    "purpose": "اختاروا توقيتًا مناسبًا إن أحببتم."
  },
  {
    "id": "q063",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "كل طرف يرسل للآخر رسالة تقدير من جملة واحدة.",
    "purpose": "ممكن تنفيذها الآن أو لاحقًا."
  },
  {
    "id": "q064",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "وش أكثر شيء يخلي وقتكم معًا متوازنًا؟",
    "purpose": "اختاروا عادة صغيرة تحافظون عليها."
  },
  {
    "id": "q065",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش أفضل وقت في اليوم بالنسبة لك؟",
    "purpose": "قارنوا روتينكم اليومي."
  },
  {
    "id": "q066",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "وش شيء جديد عرفته عني مؤخرًا؟",
    "purpose": "شجعوا الفضول والاهتمام."
  },
  {
    "id": "q067",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "خفيف",
    "text": "اشكر الطرف الثاني على شيء فعله هذا الأسبوع.",
    "purpose": "خلو الشكر واضحًا وصادقًا."
  },
  {
    "id": "q068",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "ارسموا لبعض رسمة خلال دقيقة ثم اكشفوها.",
    "purpose": "الهدف الضحك وليس جودة الرسم."
  },
  {
    "id": "q069",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "تمشية وقت الغروب أم جلسة ليلية؟",
    "purpose": "اختاروا حسب المزاج."
  },
  {
    "id": "q070",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "هدية عملية أم رسالة مكتوبة؟",
    "purpose": "لكل شخص طريقة مختلفة في التقدير."
  },
  {
    "id": "q071",
    "category": "التخمين",
    "type": "تخمين",
    "level": "خفيف",
    "text": "خمنوا: ما الشيء الذي يختاره الطرف الثاني لقضاء يوم إجازة؟",
    "purpose": "اكشفوا الإجابة بعد التخمين."
  },
  {
    "id": "q072",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "وش تصرف صغير يخليك تحس أني أسمعك فعلًا؟",
    "purpose": "ناقشوا مثالًا عمليًا."
  },
  {
    "id": "q073",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "كيف نقدر نوزع وقتنا بين الراحة والالتزامات؟",
    "purpose": "اختاروا تجربة للأسبوع القادم."
  },
  {
    "id": "q074",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "متوسط",
    "text": "اذكر ميزة في طريقة تفكير الطرف الثاني.",
    "purpose": "اختلاف التفكير ممكن يكون مفيدًا."
  },
  {
    "id": "q075",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "متوسط",
    "text": "اختاروا صورة من ذكرى مشتركة واحكوا قصتها.",
    "purpose": "تجاوزوا أي ذكرى لا يرغب أحد في مناقشتها."
  },
  {
    "id": "q076",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "وش شيء تعلمته عن نفسك خلال السنة الماضية؟",
    "purpose": "استمعوا باهتمام."
  },
  {
    "id": "q077",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "وش يساعدك على التعبير عن مشاعرك بأمان؟",
    "purpose": "ما فيه ضغط للإجابة."
  },
  {
    "id": "q078",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "ما الحدود الشخصية التي تحب أن يحترمها الطرف الآخر؟",
    "purpose": "اتفقوا على احترام خصوصية كل شخص."
  },
  {
    "id": "q079",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "عميق",
    "text": "ما معنى الشراكة العادلة بالنسبة لك؟",
    "purpose": "شاركوا التوقعات بهدوء."
  },
  {
    "id": "q080",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "كل واحد يختار للثاني لقبًا لطيفًا لهذه الجولة.",
    "purpose": "خلوه لقبًا يرضي الطرفين."
  },
  {
    "id": "q081",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "قولوا ذكرى مضحكة ما زالت تضحككم.",
    "purpose": "عيشوا اللحظة بدون تقييم."
  },
  {
    "id": "q082",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "متوسط",
    "text": "ميزانية للأنشطة أم تجربة واحدة مميزة؟",
    "purpose": "ناقشوا ما يناسبكم ماليًا."
  },
  {
    "id": "q083",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "متوسط",
    "text": "حل المشكلة فورًا أم أخذ استراحة ثم العودة؟",
    "purpose": "حددوا ما يفيد وقت الخلاف."
  },
  {
    "id": "q084",
    "category": "التخمين",
    "type": "تخمين",
    "level": "متوسط",
    "text": "خمنوا: ما أكثر شيء يشتت تركيز الطرف الثاني؟",
    "purpose": "ناقشوا كيف يمكن المساعدة."
  },
  {
    "id": "q085",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "ما المهارة التي ودك تتعلمها؟",
    "purpose": "اقترحوا طريقة للتجربة."
  },
  {
    "id": "q086",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "ما أفضل طريقة للاعتذار بالنسبة لك؟",
    "purpose": "تحدثوا عن السلوك الذي يصلح الموقف."
  },
  {
    "id": "q087",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "خفيف",
    "text": "اذكر شيئًا يعجبك في شجاعة الطرف الثاني أو اجتهاده.",
    "purpose": "ركزوا على موقف محدد."
  },
  {
    "id": "q088",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "متوسط",
    "text": "خططوا لقائمة من ثلاثة أشياء ممتعة بلا تكلفة عالية.",
    "purpose": "اختاروا واحدة للأسبوع القادم."
  },
  {
    "id": "q089",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "خفيف",
    "text": "ما الشيء الذي تتمنى أن يتكرر من هذا الأسبوع؟",
    "purpose": "لاحظوا اللحظات الجيدة."
  },
  {
    "id": "q090",
    "category": "التقارب",
    "type": "سؤال",
    "level": "متوسط",
    "text": "ما موضوع تتمنى أن نتحدث عنه أكثر؟",
    "purpose": "حددوا وقتًا مناسبًا له."
  },
  {
    "id": "q091",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "كيف تعرف أنك تحتاج مساحة شخصية؟",
    "purpose": "اتفقوا على طريقة لطلب المساحة باحترام."
  },
  {
    "id": "q092",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "خفيف",
    "text": "اختاروا وجبة جديدة لتحضيرها معًا لاحقًا.",
    "purpose": "خلوا التنفيذ اختياريًا."
  },
  {
    "id": "q093",
    "category": "اختاروا سوا",
    "type": "اختياران",
    "level": "خفيف",
    "text": "مغامرة خارجية أم نشاط إبداعي داخل البيت؟",
    "purpose": "اختاروا ثم اشرحوا السبب."
  },
  {
    "id": "q094",
    "category": "التخمين",
    "type": "تخمين",
    "level": "خفيف",
    "text": "خمنوا: ما نوع المفاجآت التي يحبها الطرف الثاني؟",
    "purpose": "ليس مطلوبًا شراء شيء."
  },
  {
    "id": "q095",
    "category": "الامتنان",
    "type": "تقدير",
    "level": "متوسط",
    "text": "ما موقف شعرت فيه أنكما فريق واحد؟",
    "purpose": "ما الذي ساعد على نجاحه؟"
  },
  {
    "id": "q096",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "ما عادة صغيرة يمكن أن تجعل أسبوعنا أسهل؟",
    "purpose": "اجعلوا التغيير بسيطًا."
  },
  {
    "id": "q097",
    "category": "التقارب",
    "type": "سؤال",
    "level": "خفيف",
    "text": "ما رائحة أو صوت يذكرك بذكرى جميلة؟",
    "purpose": "شاركوا تفاصيل الذكرى."
  },
  {
    "id": "q098",
    "category": "تحديات لطيفة",
    "type": "تحدي",
    "level": "متوسط",
    "text": "أعدوا قائمة تشغيل من ثلاث أغانٍ تناسب مزاجكم.",
    "purpose": "شاركوا سبب كل اختيار."
  },
  {
    "id": "q099",
    "category": "التقارب",
    "type": "سؤال",
    "level": "عميق",
    "text": "كيف نقدر نوضح احتياجاتنا بدون لوم؟",
    "purpose": "استخدموا عبارات تبدأ بـ«أنا أحتاج»."
  },
  {
    "id": "q100",
    "category": "تأمل ومراجعة",
    "type": "تأمل",
    "level": "متوسط",
    "text": "ما الشيء الذي تريد أن نحتفل به حتى لو كان صغيرًا؟",
    "purpose": "حددوا طريقة بسيطة للاحتفال."
  }
]